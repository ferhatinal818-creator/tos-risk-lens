{
  "manifest_version": 3,
  "name": "ToS Risk Lens",
  "version": "0.1.0",
  "description": "Kullanım koşulları, gizlilik politikası ve abonelik şartlarını okur; alıntıyla doğrulanmış bir risk raporu üretir. Hukuki tavsiye vermez.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_title": "ToS Risk Lens — bu sayfayı analiz et" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
